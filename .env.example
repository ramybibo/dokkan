# Public values (safe in the browser). Find them in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: canonical site URL used in confirmation emails (e.g. https://dokkan.vercel.app).
# If empty, it is derived from the request headers.
NEXT_PUBLIC_SITE_URL=

# Phase 1 does NOT need the service-role / secret key. When a later phase does, it goes in
# Vercel as a *sensitive* env var, never in this file and never in NEXT_PUBLIC_*.
